# Backend runtime
NODE_ENV=development
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:8787
NEX_INVITE_CODE=replace-with-a-private-invite-code
TURSO_DATABASE_URL=file:./local.db
TURSO_AUTH_TOKEN=

# Catalog and AI (optional; fixtures are used when absent)
TMDB_READ_ACCESS_TOKEN=
TMDB_METADATA_CACHE_TTL_SECONDS=604800
TMDB_AVAILABILITY_CACHE_TTL_SECONDS=21600
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_CHAT_MODEL=
AI_DAILY_MESSAGE_LIMIT=30

# Free XMLTV EPG
EPG_SOURCE_TYPE=fixture
IPTV_ORG_API_BASE=https://iptv-org.github.io/api
EPG_COUNTRIES=RO,BG,GB,ES,FR,CH,IT,DE,MD
# Set EPG_SOURCE_TYPE=iptv-org for live country feeds. URLs are public, not keys.
# Optional per-country overrides, not a required list of every EPG_COUNTRIES entry.
# Omitted countries use discovery (GB maps to UK; MD uses a strictly filtered RO subset).
# RO1 is intentional: RO2 had sparse programme coverage in the September 27 check.
EPG_COUNTRY_SOURCES_JSON={"RO":["https://epgshare01.online/epgshare01/epg_ripper_RO1.xml.gz"],"BG":["https://epgshare01.online/epgshare01/epg_ripper_BG1.xml.gz"]}
EPG_MAX_CHANNELS_PER_COUNTRY=60
EPG_MAX_FEEDS_PER_COUNTRY=3
EPG_MAX_DOWNLOAD_BYTES=75000000
EPG_MAX_MATCHES_PER_SYNC=5
EPG_XMLTV_URL=
EPG_XMLTV_PATH=
EPG_SYNC_SECRET=replace-with-a-random-sync-secret
EPG_RETENTION_PAST_DAYS=7
EPG_RETENTION_FUTURE_DAYS=14

# Public/mobile integration
API_BASE_URL=http://localhost:8787
ALLOWED_ORIGINS=http://localhost:3000

# Optional deployment automation
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
